# Copy to .env and fill in. Never commit .env.
# Only fill what the part you're working on needs.

# --- Capture (MediaPipe + the local detector) ---
# Needs the heavy extra: cd pipeline && uv sync --extra capture
# Records per second written to the capture JSONL
CAPTURE_FPS=15
# MediaPipe task bundles. Free, no key; download once (not in git):
#   curl -L --create-dirs -o models/pose_landmarker_lite.task https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/latest/pose_landmarker_lite.task
#   curl -L --create-dirs -o models/hand_landmarker.task https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task
MEDIAPIPE_POSE_MODEL=models/pose_landmarker_lite.task
MEDIAPIPE_HAND_MODEL=models/hand_landmarker.task
# Trained detector weights, exported from Roboflow and run locally (ONNX; never hosted
# inference). Empty means capture runs with the fake detector and reports no objects.
DETECTOR_WEIGHTS=
# Where a live camera session (/ws/live?source=camera, scripts/camera.sh --record) also
# writes its records, so it can be replayed offline afterwards. Empty keeps nothing.
# Landmarks, boxes and timestamps only, like every capture file; never video.
CAMERA_RECORD=
# Set to 1 to let the capture process show this machine its own camera picture under
# the skeleton while it films (scripts/camera.sh --preview). Served on 127.0.0.1 only,
# one frame at a time in memory: never stored, never sent to the API or a supervisor.
CAMERA_PREVIEW=0
# Which loopback port that preview listens on, and the same port the dashboard looks
# for it on (Vite only exposes VITE_* vars, so both are set; scripts/camera.sh does it).
PREVIEW_PORT=8765
VITE_PREVIEW_PORT=8765

# --- Object detector (Roboflow) ---
# Training and exporting weights only; the pipeline never calls hosted inference.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_MODEL_VERSION=1

# --- Time-series store (Tiger Data / TimescaleDB) ---
# postgres://user:password@host:port/tsdb?sslmode=require
DATABASE_URL=
# Optional deploy/docker-compose.yml tsdb profile (local DB only; choose a strong secret).
POSTGRES_PASSWORD=

# --- Vision verifier (Gemini) ---
GEMINI_API_KEY=
# cheapest that works; dev default
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Alert summaries (Anthropic) ---
ANTHROPIC_API_KEY=
# Haiku for dev; switch to Sonnet for the demo only if summaries need it
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Realtime alerts (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Exposed to the browser (Vite only exposes VITE_* vars)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- LLM / feedback tracing (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
# Comma-separated dashboard origins the API accepts (CORS)
CORS_ORIGINS=http://localhost:5173
# Run without network calls (verifier/summaries degrade gracefully, SPEC §10 fallback)
OFFLINE_MODE=true
# Set to 1 to allow real paid API calls (cached in .cache/api/)
LIVE_API=0
# Where cached paid-API responses live (default .cache/api/ in the repo)
API_CACHE_DIR=
# Where skeleton replays of sessions with errors are kept (SPEC §17). Empty keeps them
# in this process only, gone when the API restarts; a directory keeps them on disk as
# one gzipped JSONL file per session. Landmarks, boxes and timestamps; never video.
REPLAY_DIR=
# How many days of replays to keep. Older ones are pruned whenever a replay is saved.
REPLAY_RETENTION_DAYS=30
# Set to 1 to enable POST /demo/reset outside OFFLINE_MODE (puts the demo back to its
# seeded history between rehearsals); OFFLINE_MODE=true already enables it
DEMO_RESET=0
